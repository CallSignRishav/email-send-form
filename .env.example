# Email – Gmail App Password (requires 2-Step Verification)
# See https://nodemailer.com/guides/using-gmail#app-password-requires-2-step-verification
# Generate a 16-char App Password at https://myaccount.google.com/apppasswords
EMAIL_FROM="me@gmail.com" # Gmail address that owns the App Password
EMAIL_PASS="abcd abcd abcd abcd" # 16-char App Password (spaces optional, will be stripped)
EMAIL_TO="admin@example.com" # where admin notifications go
